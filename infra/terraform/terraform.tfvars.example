# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

project_id  = "YOUR_GCP_PROJECT_ID"
region      = "us-central1"
github_repo = "YOUR_GITHUB_ORG/YOUR_REPO_NAME"

# Add one entry per data source.
# Each entry auto-generates 5 Cloud Run Jobs + a Cloud Workflow + a Cloud Scheduler
# trigger. Run /add-data-source in Claude Code to scaffold a new source end-to-end.
#
# Two naming rules the map key must obey:
#   - It becomes the Cloud Run Job and Cloud Workflow name, so it must be lowercase
#     letters, digits and hyphens only — no underscores.
#   - infra/workflows/<key>_pipeline.yaml must exist (workflows.tf reads it via file()).
#
# Secret Manager secret names must equal the environment variable name the job expects
# — sources.tf maps them 1:1 (secret_key_ref { secret = <the key below> }).
#
# open-meteo is the zero-setup reference source shipped with this template — it needs
# no API key, so `setup-fork` provisions and verifies it by default and it is active
# below out of the box. fred-economic is included (commented out) as a working example
# of a source that needs a Secret-Manager-backed API key — see `.claude/skills/api-fred/
# SKILL.md`. Uncomment it once you've created its FRED_API_KEY secret (README step 9 /
# `.claude/skills/setup-fork/SKILL.md`); its `secrets` map is the pattern to copy for
# your own keyed sources.
sources = {
  open-meteo = {
    # Must equal the 01_extraction/<dir> basename — .github/workflows/deploy.yml
    # tags each image with `basename "$dir"`. Underscores are fine here.
    extraction_image = "open_meteo"
    frequency        = "daily"          # daily | weekly | monthly
    schedule         = "0 6 * * *"      # cron expression
    schedule_tz      = "America/New_York"
    env_vars         = { BQ_PROJECT_EXTRACTION = "YOUR_GCP_PROJECT_ID" }
    secrets          = {}               # no API key required — non-commercial, no signup

    timeout = "1200s"
  }

  # fred-economic = {
  #   # Must equal the 01_extraction/<dir> basename — .github/workflows/deploy.yml
  #   # tags each image with `basename "$dir"`. Underscores are fine here.
  #   extraction_image = "fred_economic"
  #   frequency        = "daily"          # daily | weekly | monthly
  #   schedule         = "0 6 * * *"      # cron expression
  #   schedule_tz      = "America/New_York"
  #   env_vars         = { BQ_PROJECT_EXTRACTION = "YOUR_GCP_PROJECT_ID" }
  #   secrets          = { FRED_API_KEY = "latest" }
  #
  #   # 118 series x 0.6s of rate-limit sleep is ~71s before any data moves, and the
  #   # first run backfills full history. The 600s default is not enough.
  #   timeout = "3600s"
  # }
}
