# .env.example — copy to .env and fill in your values (never commit .env)
#
# Authentication: do NOT use service account key files.
# Instead run: gcloud auth application-default login
# This uses your personal credentials locally; CI uses Workload Identity Federation.

# GCP
BQ_PROJECT=YOUR_GCP_PROJECT_ID
BQ_DATASET=agent_registry
DBT_SERVICE_ACCOUNT=dbt-runner@YOUR_GCP_PROJECT_ID.iam.gserviceaccount.com

# dbt — points dbt at the non-standard profiles.yml location in 02_dbt/
# Source your .env before running dbt commands, or pass --profiles-dir 02_dbt explicitly.
DBT_PROFILES_DIR=02_dbt

# Extraction jobs — GCP project/dataset for raw writes.
# BQ_PROJECT_EXTRACTION falls back to BQ_PROJECT if unset.
BQ_PROJECT_EXTRACTION=YOUR_GCP_PROJECT_ID
BQ_DATASET_EXTRACTION=raw

# Add API keys for each data source you add. In Cloud Run these come from Secret
# Manager, where the secret name must match the env var name exactly.
# Reference source (free key: https://fredaccount.stlouisfed.org/apikeys):
FRED_API_KEY=
